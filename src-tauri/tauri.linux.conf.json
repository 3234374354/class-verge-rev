{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "identifier": "io.github.classes-verge-rev.classes-verge-rev",
  "bundle": {
    "targets": ["deb", "rpm"],
    "linux": {
      "deb": {
        "depends": ["openssl"],
        "desktopTemplate": "./packages/linux/classes-verge.desktop",
        "provides": ["classes-verge"],
        "conflicts": ["classes-verge"],
        "replaces": ["classes-verge"],
        "postInstallScript": "./packages/linux/post-install.sh",
        "preRemoveScript": "./packages/linux/pre-remove.sh"
      },
      "rpm": {
        "depends": ["openssl"],
        "desktopTemplate": "./packages/linux/classes-verge.desktop",
        "provides": ["classes-verge"],
        "conflicts": ["classes-verge"],
        "obsoletes": ["classes-verge"],
        "postInstallScript": "./packages/linux/post-install.sh",
        "preRemoveScript": "./packages/linux/pre-remove.sh"
      }
    },
    "externalBin": [
      "./resources/classes-verge-service",
      "./resources/install-service",
      "./resources/uninstall-service",
      "./sidecar/verge-mihomo",
      "./sidecar/verge-mihomo-alpha"
    ]
  }
}
